# The admin console (/admin, /admin/login) is OFF unless this is "true".
#
# It is deliberately not set here. This file is committed and is also the base
# every production build reads, so setting it to "true" would publish the admin
# login screen on the deployed site. Leave it unset or "false" here.
#
# For local admin access, put this in .env.local (git-ignored, never committed):
#   VITE_ADMIN_CONSOLE=true
#
# Restart `npm run dev` after changing it — Vite only reads these at startup.
VITE_ADMIN_CONSOLE=false
